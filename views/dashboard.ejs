<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | Task Flow</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include("partials/navbar") %>
    <main class="container py-5">
      <!-- Dashboard Header -->
      <div class="mb-5">
        <h1 class="fw-bold">Dashboard</h1>

        <p class="text-muted mb-0">Overview of your task progress.</p>
      </div>

      <!-- Statistics -->
      <div class="row g-4 mb-5">
        <!-- Total Tasks -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <p class="text-muted mb-1">Total Tasks</p>

              <h2 class="fw-bold mb-0"><%= totalTasks %></h2>
            </div>
          </div>
        </div>

        <!-- Completed Tasks -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <p class="text-muted mb-1">Completed</p>

              <h2 class="fw-bold mb-0"><%= completedTasks %></h2>
            </div>
          </div>
        </div>

        <!-- Pending Tasks -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <p class="text-muted mb-1">Pending</p>

              <h2 class="fw-bold mb-0"><%= pendingTasks %></h2>
            </div>
          </div>
        </div>
      </div>

      <!-- Completion Progress -->
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-bold mb-0">Task Completion</h5>

            <span class="fw-bold"> <%= completionPercentage %>% </span>
          </div>

          <div
            class="progress"
            role="progressbar"
            aria-label="Task completion progress"
            aria-valuenow="<%= completionPercentage %>"
            aria-valuemin="0"
            aria-valuemax="100"
          >
            <div
              class="progress-bar"
              style="width: <%= completionPercentage %>%"
            ></div>
          </div>
        </div>
      </div>

      <!-- View Tasks -->
      <div class="text-center mt-4">
        <a href="/tasks" class="btn btn-primary"> View My Tasks </a>
      </div>
    </main>
    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
