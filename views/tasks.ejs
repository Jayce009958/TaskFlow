<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tasks | Task Flow</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include("partials/navbar") %>

    <main class="container py-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="fw-bold">My Tasks</h1>
          <p class="text-muted mb-0">
            Manage your tasks and track your progress.
          </p>
        </div>
        <a href="/tasks/new" class="btn btn-primary"> + Add Task </a>
      </div>
      <div class="mb-4">
        <div class="btn-group" role="group">
          <a href="/tasks<%= search ? '?search=' + encodeURIComponent(search) : '' %> " 
            class="btn <%= !status ? 'btn-primary' : 'btn-outline-primary' %> ">
            All
          </a>
          <a href="/tasks?status=pending<%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
            class="btn <%= status === 'pending' ? 'btn-primary' : 'btn-outline-primary' %>">
            Pending
          </a>
          <a href="/tasks?status=completed<%= search ? '&search=' + encodeURIComponent(search) : '' %>" 
            class="btn <%= status === 'completed' ? 'btn-primary' : 'btn-outline-primary' %>">
            Completed
          </a>
        </div>
        <form action="/tasks" method="GET" class="mb-4 mt-2">
          <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search tasks..." value="<%= search %>" />
            <button type="submit" class="btn btn-primary">Search</button>
          </div>
        </form>
      </div>
      <div class="row g-4">
        <% if (tasks.length === 0) { %>
          <div class="col-12">
            <div class="text-center py-5">
              <h4 class="fw-bold">No Tasks Found</h4>
              <p class="text-muted">There are no tasks in this category yet.</p>
              <a href="/tasks/new" class="btn btn-primary"> + Add Task</a>
            </div>
          </div>
        <% } else { %>
          <% tasks.forEach((task) => { %>
            <div class="col-md-6 col-lg-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                  <!-- Status and Task ID -->
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <% if (task.completed) { %>
                      <span class="badge text-bg-success">
                        Completed
                      </span>
                    <% } else { %>
                      <span class="badge text-bg-warning">
                        Pending
                      </span>
                    <% } %>
                    <small class="text-muted">
                      <%= task.id %>
                    </small>
                  </div>
                  <!-- Task Title -->
                  <h5 class="card-title fw-bold mb-2 <%=  task.completed ? 'text-decoration-line-through text-muted' : "" %> "> 
                    <a href="/tasks/<%= task.id %>" class="text-decoration-none text-dark"><%= task.title %>
                    </a>
                  </h5>
                  <!-- Task Description -->
                  <p class="card-text text-muted flex-grow-1">
                  <%= task.description %>
                  </p>
                  <!-- Action Buttons -->
                  <div class="d-flex flex-wrap gap-2 mt-3">
                    <a href="/tasks/<%= task.id %>" class="btn btn-outline-primary btn-sm">
                      View
                    </a>
                    <a href="/tasks/<%= task.id %>" class="btn btn-outline-secondary btn-sm">
                      Edit
                    </a>
                    <form action="/tasks/<%= task.id %>/toggle" method="POST" class="d-inline">
                      <button type="submit" class="btn <%= task.completed ? 'btn-outline-secondary' : 'btn-outline-success' %> btn-sm">
                        <%= task.completed ? "Undo" : "Complete" %>
                      </button>
                    </form>
                    <form 
                      action="/tasks/<%= task.id %>/delete" 
                      method="POST" 
                      class="d-inline" 
                      onsubmit="return confirm('Are you sure you want to delete this task?');"
                    >
                      <button type="submit" class="btn btn-outline-danger btn-sm">
                        Delete
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </main>

    <%- include("partials/footer") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
