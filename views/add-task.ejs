<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Task | Task Flow</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include("partials/navbar") %>

    <main class="container py-5">
      <!-- Page Header -->
      <div class="mb-4">
        <a href="/tasks" class="text-decoration-none"> &larr; Back to Tasks </a>

        <h1 class="fw-bold mt-3">Create a New Task</h1>

        <p class="text-muted">
          Add a task to your list and keep your work organized.
        </p>
      </div>

      <!-- Add Task Form -->
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
              <form action="/tasks" method="POST">
                <!-- Task Title -->
                <div class="mb-4">
                  <label for="title" class="form-label fw-bold">
                    Task Title
                  </label>

                  <input
                    type="text"
                    class="form-control form-control-lg"
                    id="title"
                    name="title"
                    placeholder="e.g. Finish my portfolio website"
                    required
                    maxlength="100"
                  />
                </div>

                <!-- Task Description -->
                <div class="mb-4">
                  <label for="description" class="form-label fw-bold">
                    Description
                  </label>

                  <textarea
                    class="form-control"
                    id="description"
                    name="description"
                    rows="5"
                    placeholder="Describe what you need to accomplish..."
                  ></textarea>
                </div>

                <!-- Form Actions -->
                <div class="d-flex flex-wrap gap-2">
                  <button type="submit" class="btn btn-primary btn-lg">
                    Create Task
                  </button>

                  <a href="/tasks" class="btn btn-outline-secondary btn-lg">
                    Cancel
                  </a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
