<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>About | TaskFlow</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/styles.css" />
  </head>

  <body>
    <!-- Navbar -->
    <%- include("partials/navbar") %>

    <main>
      <!-- About Hero Section -->
      <section class="container py-5">
        <div class="row justify-content-center text-center py-5">
          <div class="col-lg-9">
            <span class="badge text-bg-primary mb-3"> About TaskFlow </span>

            <h1 class="display-4 fw-bold mb-4">
              Productivity Made <span class="text-primary">Simple.</span>
            </h1>

            <p class="lead text-muted mb-4">
              TaskFlow is a task management application designed to help you
              organize your responsibilities, track your progress, and stay
              focused on what matters most.
            </p>

            <a href="/tasks" class="btn btn-primary btn-lg"> Get Started </a>
          </div>
        </div>
      </section>

      <!-- Mission Section -->
      <section class="bg-light py-5">
        <div class="container">
          <div class="row justify-content-center text-center">
            <div class="col-lg-8">
              <h2 class="fw-bold mb-3">Our Mission</h2>

              <p class="text-muted fs-5">
                Our goal is to make task management simple and accessible. By
                keeping tasks organized in one place, TaskFlow helps users
                manage their workload and build better productivity habits.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="container py-5">
        <div class="text-center mb-5">
          <h2 class="fw-bold">What You Can Do With TaskFlow</h2>

          <p class="text-muted">
            Everything you need to organize your daily tasks.
          </p>
        </div>

        <div class="row g-4">
          <!-- Feature 1 -->
          <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body p-4">
                <div class="badge text-bg-primary p-2 mb-3">01</div>

                <h5 class="fw-bold">Manage Tasks</h5>

                <p class="text-muted mb-0">
                  Create new tasks, update existing ones, view their details,
                  and delete tasks you no longer need.
                </p>
              </div>
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body p-4">
                <div class="badge text-bg-success p-2 mb-3">02</div>

                <h5 class="fw-bold">Track Progress</h5>

                <p class="text-muted mb-0">
                  Mark tasks as completed, undo completion when necessary, and
                  monitor your overall progress on the dashboard.
                </p>
              </div>
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body p-4">
                <div class="badge text-bg-warning p-2 mb-3">03</div>

                <h5 class="fw-bold">Search and Filter</h5>

                <p class="text-muted mb-0">
                  Quickly find tasks by title or description and filter them
                  according to their completion status.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Technology Section -->
      <section class="bg-light py-5">
        <div class="container text-center">
          <h2 class="fw-bold mb-3">Built With</h2>

          <p class="text-muted mb-4">
            TaskFlow was developed using these web technologies.
          </p>

          <div class="d-flex flex-wrap justify-content-center gap-3">
            <span class="badge text-bg-dark p-3">Node.js</span>
            <span class="badge text-bg-dark p-3">Express.js</span>
            <span class="badge text-bg-dark p-3">EJS</span>
            <span class="badge text-bg-dark p-3">JavaScript</span>
            <span class="badge text-bg-dark p-3">Bootstrap 5</span>
            <span class="badge text-bg-dark p-3">CSS3</span>
            <span class="badge text-bg-dark p-3">JSON</span>
          </div>
        </div>
      </section>

      <!-- Call to Action -->
      <section class="container py-5">
        <div class="text-center py-4">
          <h2 class="fw-bold mb-3">Ready to Get Organized?</h2>

          <p class="text-muted mb-4">
            Start managing your tasks and make progress one step at a time.
          </p>

          <a href="/tasks" class="btn btn-primary btn-lg"> Explore My Tasks </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
