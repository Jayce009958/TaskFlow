<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Task Flow</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include("partials/navbar") %>

    <main>
      <!-- Hero Section -->
      <section class="container py-5">
        <div class="row align-items-center py-5">
          <!-- Left Side: Text -->
          <div class="col-lg-7">
            <span class="badge text-bg-primary mb-3">
              Your Personal Productivity Tool
            </span>
            <h1 class="display-4 fw-bold mb-4">
              Get Things Done
              <span class="text-primary">One Task at a Time.</span>
            </h1>
            <p class="lead text-muted mb-4">
              TaskFlow helps you organize your work, track your progress, and
              stay focused on what matters most.
            </p>
            <div class="d-flex flex-wrap gap-3">
              <a href="/tasks" class="btn btn-primary btn-lg"> View My Task </a>
              <a href="/dashboard" class="btn btn-outline-dark btn-lg">
                View Dashboard
              </a>
            </div>
          </div>
          <!-- Right Side: Feature Card -->
          <div class="col-lg-5 mt-5 mt-lg-0">
            <div class="card border-0 shadow p-4">
              <div class="card-body">
                <h5 class="fw-bold mb-4">Stay on Track</h5>
                <div class="d-flex align-item-start mb-4">
                  <div class="me-3">
                    <span class="badge text-bg-success p-2"> ✓ </span>
                  </div>
                  <div>
                    <h6 class="fw-bold mb-1">Organized Your Tasks</h6>
                    <p class="text-muted mb-0">
                      Keep your tasks organized in one place.
                    </p>
                  </div>
                </div>
                <div class="d-flex align-item-start mb-4">
                  <div class="me-3">
                    <span class="badge text-bg-primary p-2"> ↗ </span>
                  </div>
                  <div>
                    <h6 class="fw-bold mb-1">Track Your Progress</h6>
                    <p class="text-muted mb-0">
                      See completed and pending tasks at a glance.
                    </p>
                  </div>
                </div>
                <div class="d-flex text-align-start">
                  <div class="me-3">
                    <span class="badge text-bg-warning p-2"> ★ </span>
                  </div>
                  <div>
                    <h6 class="fw-bold mb-1">Stay Productive</h6>
                    <p class="text-muted mb-0">
                      Focus on your priorities and keep moving forward.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="bg-light py-5">
        <div class="container">
          <div class="text-center mb-5">
            <h2 class="fw-bold">Everything You Need to Stay Organized</h2>
            <p class="text-muted">
              Simple tools to help you manage your daily workload.
            </p>
          </div>
          <div class="row g-4">
            <div class="col-md-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                  <h5 class="fw-bold">Task Manager</h5>
                  <p class="text-muted mb-0">
                    Create, edit, view, and delete tasks whenever you need to.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                  <h5 class="fw-bold">Progress Tracking</h5>
                  <p class="text-muted mb-0">
                    Mark tasks as completed and monitor your overall progress.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                  <h5 class="fw-bold">Search and Filter</h5>
                  <p class="text-muted mb-0">
                    Quickly find tasks and filter them by their completion
                    status.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include("partials/footer") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
