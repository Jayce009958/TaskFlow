<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Task Details | Task Flow</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>

    <%- include("partials/navbar") %>
    
    <main class="container py-5">
        <!-- Page Header -->
        <div class="mb-4">
            <a href="/tasks" class="text-decoration-none">
                &larr; Back to Tasks
            </a>
            <h1 class="fw-bold mt-3">Task Details</h1>
            <p class="text-muted">
                View the details and manage your task.
            </p>
        </div>
        <!-- Task Details Card -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">

                        <!-- Task ID and Status -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="text-muted">
                                Task #<%= task.id %>
                            </span>
                            <% if (task.completed) { %>
                            <span class="badge text-bg-success p-2">
                                Completed
                            </span>
                            <% } else { %>
                            <span class="badge text-bg-warning p-2">
                                Pending
                            </span>
                            <% } %>
                        </div>

                        <!-- Task Title -->
                        <h2 class="fw-bold mb-3">
                            <%= task.title %>
                        </h2>

                        <!-- Task Description -->
                        <h6 class="fw-bold text-muted">
                            Description
                        </h6>
                        <p class="mb-4" style="white-space: pre-wrap;"><%= task.description || "No description provided." %></p>
                        <hr class="my-4">

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap gap-2">
                            <a
                                href="/tasks/<%= task.id %>/edit"
                                class="btn btn-primary"
                            >
                                Edit Task
                            </a>
                            <form
                                action="/tasks/<%= task.id %>/toggle"
                                method="POST"
                            >
                            <button type="submit" class="btn btn-outline-success">
                                <%= task.completed ? "Undo Completion" : "Mark as Completed" %>
                            </button>
                            </form>
                            <form
                                action="/tasks/<%= task.id %>/delete"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this task?');"
                            >
                            <button type="submit" class="btn btn-outline-danger">
                                Delete Task
                            </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include("partials/footer"); %>

  </body>
</html>
